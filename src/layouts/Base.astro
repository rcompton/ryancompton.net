---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  published?: Date;
}

const { title, description, published } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | ${SITE.description}`;
const metaDescription = description || SITE.description;
const canonical = new URL(Astro.url.pathname.replace(/\/index\.html$/, '/'), SITE.url).href;
const ogType = published ? 'article' : 'website';
// Google Analytics 4; only in production builds so local previews aren't counted.
const GA_ID = 'G-VCH113NQZY';
const analytics = import.meta.env.PROD;

const jsonLd = published
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      author: { '@type': 'Person', name: SITE.title },
      datePublished: published.toISOString(),
      dateModified: published.toISOString(),
      description: metaDescription,
      headline: title,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      url: canonical,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      author: { '@type': 'Person', name: SITE.title },
      description: metaDescription,
      headline: title ?? SITE.title,
      name: SITE.title,
      url: canonical,
    };
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE.title} />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta property="twitter:title" content={title ?? SITE.title} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="alternate" type="application/rss+xml" href={new URL('/feed.xml', SITE.url)} title={SITE.title} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#111315" />
    {
      analytics && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', GA_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">{SITE.title}</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/about.html" aria-current={Astro.url.pathname === '/about.html' ? 'page' : undefined}>About</a>
          <a href="/feed.xml">RSS</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE.title}</span>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>Email</a></li>
          <li><a rel="me" href="https://github.com/rcompton">GitHub</a></li>
          <li><a rel="me" href="https://www.linkedin.com/in/%E2%87%89ryan-compton%E2%87%87-2503941a/">LinkedIn</a></li>
          <li><a rel="me" href="https://stackoverflow.com/users/424631/dranxo">Stack Overflow</a></li>
          <li><a href="/feed.xml">RSS</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
