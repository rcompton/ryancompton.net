---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, previewText, leadMedia } from '../lib/posts';

const posts = await getPosts();
---

<Base>
  <ul class="index">
    {
      posts.map((post, i) => {
        const html = post.rendered?.html ?? '';
        const lead = leadMedia(html);
        return (
          <li class="card">
            <a href={post.url}>
              {lead ? (
                <div class:list={['frame', { video: lead.video }]}>
                  <img
                    src={lead.src}
                    alt=""
                    loading={i < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                    onerror={lead.fallback ? `this.onerror=null;this.src='${lead.fallback}'` : undefined}
                  />
                </div>
              ) : (
                <div class="frame words">
                  <p>{previewText(html, 420)}</p>
                </div>
              )}
              <h2>{post.data.title}</h2>
            </a>
            <div class="meta">
              <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
              {post.data.tags.length > 0 && <span class="tags">{post.data.tags.join(', ')}</span>}
            </div>
          </li>
        );
      })
    }
  </ul>
</Base>
