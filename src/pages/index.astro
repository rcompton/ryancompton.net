---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, leadMedia } from '../lib/posts';

const posts = await getPosts();
let plates = 0;
---

<Base>
  <ol class="feed">
    {
      posts.map((post) => {
        const lead = leadMedia(post.rendered?.html ?? '');
        return (
          <li class:list={['entry', { 'has-plate': lead }]}>
            <div class="meta">
              <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
              {post.data.tags.length > 0 && <span class="tags">{post.data.tags.join(', ')}</span>}
            </div>
            <h2>
              <a href={post.url}>{post.data.title}</a>
            </h2>
            {lead && (
              <a class:list={['plate', { video: lead.video }]} href={post.url} tabindex="-1" aria-hidden="true">
                <img
                  src={lead.src}
                  alt=""
                  loading={plates++ < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  onerror={lead.fallback ? `this.onerror=null;this.src='${lead.fallback}'` : undefined}
                />
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</Base>
