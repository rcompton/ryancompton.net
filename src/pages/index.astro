---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, previewText, type Post } from '../lib/posts';

const posts = await getPosts();
const years = new Map<string, Post[]>();
for (const post of posts) years.set(post.year, [...(years.get(post.year) ?? []), post]);
---

<Base>
  {
    [...years].map(([year, yearPosts]) => (
      <section>
        <h2 class="year">{year}</h2>
        <ul class="post-list">
          {yearPosts.map((post) => (
            <li>
              <div class="title">
                <a href={post.url}>{post.data.title}</a>
                <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date).replace(/, \d{4}$/, '')}</time>
              </div>
              <p>{previewText(post.rendered?.html ?? '')}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
