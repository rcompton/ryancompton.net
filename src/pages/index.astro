---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, previewText, leadMedia, type Post } from '../lib/posts';

const posts = await getPosts();
const years = new Map<string, Post[]>();
for (const post of posts) years.set(post.year, [...(years.get(post.year) ?? []), post]);
let imagesSeen = 0;
---

<Base>
  {
    [...years].map(([year, yearPosts]) => (
      <section>
        <h2 class="year">{year}</h2>
        <ul class="post-list">
          {yearPosts.map((post) => {
            const html = post.rendered?.html ?? '';
            const lead = leadMedia(html);
            const eager = lead && imagesSeen++ < 2;
            return (
              <li>
                <div class="title">
                  <a href={post.url}>{post.data.title}</a>
                  <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date).replace(/, \d{4}$/, '')}</time>
                </div>
                {lead && (
                  <a class:list={['lead', { video: lead.video }]} href={post.url} tabindex="-1" aria-hidden="true">
                    <img
                      src={lead.src}
                      alt={lead.alt}
                      loading={eager ? 'eager' : 'lazy'}
                      decoding="async"
                      onerror={lead.fallback ? `this.onerror=null;this.src='${lead.fallback}'` : undefined}
                    />
                  </a>
                )}
                <p>{previewText(html)}</p>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</Base>
